PORT=4000

# AI provayderi: openai (Groq/OpenRouter uyğun API) | gemini | anthropic
AI_PROVIDER=openai
AI_API_KEY=buraya-groq-api-acarinizi-yazın
AI_MODEL=openai/gpt-oss-120b
# Groq API endpoint-i:
# AI_BASE_URL=https://api.groq.com/openai/v1
AI_DAILY_LIMIT=200

# Supabase PostgreSQL pooler connection string; required for marketplace accounts and data.
DATABASE_URL=

# 64+ random characters. Generate locally; never commit or share this value.
APP_JWT_SECRET=

# Optional: comma-separated production frontend origins, e.g. https://your-site.vercel.app
CORS_ORIGIN=
