PORT=4000

# AI provayderi: gemini (pulsuz, tövsiyə) | openai (Groq/OpenRouter) | anthropic (ödənişli)
AI_PROVIDER=gemini
AI_API_KEY=buraya-oz-acariniz
AI_MODEL=gemini-3.7-flash
# Yalnız AI_PROVIDER=openai üçün (Groq nümunəsi):
# AI_BASE_URL=https://api.groq.com/openai/v1
AI_DAILY_LIMIT=200

# Supabase PostgreSQL pooler connection string; required for marketplace accounts and data.
DATABASE_URL=

# 64+ random characters. Generate locally; never commit or share this value.
APP_JWT_SECRET=

# Optional: comma-separated production frontend origins, e.g. https://your-site.vercel.app
CORS_ORIGIN=
